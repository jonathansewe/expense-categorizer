{
  "name": "sewe-finance-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects app",
    "test:exercises": "SOLUTION=reference jest --selectProjects exercises",
    "export:web": "expo export --platform web"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/tests/**/*.test.ts?(x)"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup.ts"
        ]
      },
      {
        "displayName": "exercises",
        "preset": "jest-expo",
        "roots": [
          "<rootDir>/../exercises"
        ],
        "testMatch": [
          "<rootDir>/../exercises/**/*.test.ts"
        ]
      }
    ]
  }
}
